@page
@model DrinkWeb.Pages.SearchModel
@{
    ViewData["Title"] = "Search";
}

<h1>Search by name</h1>

<form method="get">
    <div class="input-group mb-3">
        <input asp-for="Name" class="form-control" placeholder="e.g. Margarita" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.Searched && Model.Results.Count == 0)
{
    <p>No drinks found.</p>
}
else if (Model.Results.Count > 0)
{
    <ul class="list-group">
        @foreach (var drink in Model.Results)
        {
            <li class="list-group-item">
                <a asp-page="/Details" asp-route-id="@drink.IdDrink">@drink.StrDrink</a>
            </li>
        }
    </ul>
}